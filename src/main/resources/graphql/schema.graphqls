# -----------------------------------------
# QUERIES (Veri Okuma İşlemleri - REST'teki GET)
# -----------------------------------------
type Query {
    # İleride sayfalamalı (Pagination) getireceğimiz restoran listesi
    restaurants(page: Int = 0, size: Int = 10): RestaurantPage!
    restaurant(id: ID!): Restaurant

    # Restoranın menüsündeki ürünler
    products(restaurantId: ID!): [Product]!

    # Giriş yapan müşterinin siparişleri
    customerOrders(page: Int = 0, size: Int = 10): OrderPage!
}

# -----------------------------------------
# MUTATIONS (Veri Değiştirme İşlemleri - REST'teki POST/PUT/DELETE)
# -----------------------------------------
type Mutation {
    createRestaurant(input: CreateRestaurantInput!): Restaurant!
    createProduct(input: CreateProductInput!): Product!
    createOrder(input: CreateOrderInput!): OrderResponse!
}

# -----------------------------------------
# TYPES (Geri Dönüş Tipleri - DTO Response Karşılıkları)
# -----------------------------------------
type Restaurant {
    id: ID!
    name: String!
    description: String
    phone: String!
    email: String!
    active: Boolean!
}

# Spring Data Page<T> nesnesinin GraphQL'deki karşılığı
type RestaurantPage {
    content: [Restaurant]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Product {
    id: ID!
    restaurantId: ID!
    name: String!
    description: String
    price: Float!
    category: String!
    available: Boolean!
    imageUrl: String
}

type OrderResponse {
    id: ID!
    customerId: ID!
    restaurantId: ID!
    status: String!
    totalPrice: Float!
    deliveryAddress: String!
}

type OrderPage {
    content: [OrderResponse]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

# -----------------------------------------
# INPUTS (İstemciden Gelen Veri Tipleri - Request DTO Karşılıkları)
# -----------------------------------------
# Java'daki JSONB Map yapılarını GraphQL'de esnek tutmak için "String" (JSON string) olarak alabiliriz
# veya özel Scalar tipler yazabiliriz. Şimdilik basitlik için JSON formatında String kabul ediyoruz.
input CreateRestaurantInput {
    name: String!
    description: String
    phone: String!
    email: String!
    address: String!
    workingHours: String!
}

input CreateProductInput {
    restaurantId: ID!
    name: String!
    description: String
    price: Float!
    category: String!
    imageUrl: String
}

input CreateOrderInput {
    restaurantId: ID!
    deliveryAddress: String!
    items: [OrderItemInput!]!
}

input OrderItemInput {
    productId: ID!
    quantity: Int!
}