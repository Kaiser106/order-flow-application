# -----------------------------------------
# QUERIES (Veri Okuma İşlemleri - REST'teki GET)
# -----------------------------------------
type Query {
    restaurants(page: Int = 0, size: Int = 10): RestaurantPage!
    restaurant(id: ID!): Restaurant
    products(restaurantId: ID!): [Product]!
    customerOrders(page: Int = 0, size: Int = 10): OrderPage!
    availableOrders(page: Int = 0, size: Int = 10): OrderPage!
    courierOrders(page: Int = 0, size: Int = 10): OrderPage!
}

# -----------------------------------------
# MUTATIONS (Veri Değiştirme İşlemleri - REST'teki POST/PUT/DELETE)
# -----------------------------------------
type Mutation {

    updateRestaurant(input: UpdateRestaurantInput!): Restaurant!

    createProduct(input: CreateProductInput!): Product!
    createOrder(input: CreateOrderInput!): OrderResponse!
    cancelOrder(id: ID!): OrderResponse!
    updateOrderStatus(orderId: ID!, status: String!): OrderResponse!
}

# -----------------------------------------
# TYPES (Geri Dönüş Tipleri - DTO Response Karşılıkları)
# -----------------------------------------
type Restaurant {
    id: ID!
    name: String!
    description: String
    phone: String!
    email: String!
    active: Boolean!
}

type RestaurantPage {
    content: [Restaurant]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Product {
    id: ID!
    restaurantId: ID!
    name: String!
    description: String
    price: Float!
    category: String!
    available: Boolean!
    imageUrl: String
}

type OrderResponse {
    id: ID!
    customerId: ID!
    restaurantId: ID!
    status: String!
    totalPrice: Float!
    deliveryAddress: String!
}

type OrderPage {
    content: [OrderResponse]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

# -----------------------------------------
# INPUTS (İstemciden Gelen Veri Tipleri - Request DTO Karşılıkları)
# -----------------------------------------
input UpdateRestaurantInput {
    name: String!
    description: String
    phone: String!
    email: String!
    address: String!      # JSON formatında string
    workingHours: String! # JSON formatında string
    active: Boolean!
}

input CreateProductInput {

    name: String!
    description: String
    price: Float!
    category: String!
    imageUrl: String
}

input CreateOrderInput {
    restaurantId: ID!
    deliveryAddress: String!
    items: [OrderItemInput!]!
}

input OrderItemInput {
    productId: ID!
    quantity: Int!
}
